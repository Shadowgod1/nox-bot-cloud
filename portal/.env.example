# Nox portal settings (/opt/nox-portal/.env, mode 600). portal-install.sh creates this file from here,
# replaces __GENERATE__ with fresh secrets and sets NOX_PROVISIONER_TOKEN_SHA256. Placeholders only.

# Public address of the portal (https => Secure cookies) and the domain of client bots (<slug>.<domain>)
NOX_PUBLIC_URL=https://bot.noxsw.kz
NOX_INSTANCE_DOMAIN=noxsw.kz
# Extra reserved bot addresses, comma separated (the built-in list is in nox_portal/slugs.py)
NOX_RESERVED_SLUGS=

# Secrets (generated by portal-install.sh, never commit real values)
NOX_SECRET_KEY=__GENERATE__
NOX_DB_PASSWORD=__GENERATE__
# sha256 of the provisioner token in /etc/nox-portal/provisioner.env (set by portal-install.sh)
NOX_PROVISIONER_TOKEN_SHA256=

# E-mail: smtp | log (development only: letters with codes and links go to the log)
NOX_EMAIL_MODE=smtp
NOX_SMTP_HOST=smtp.example.kz
NOX_SMTP_PORT=587
# starttls (587) | ssl (465) | none
NOX_SMTP_SECURITY=starttls
NOX_SMTP_USER=bot@example.kz
NOX_SMTP_PASSWORD=
NOX_SMTP_FROM=bot@example.kz
# optional Reply-To of every letter (e.g. a human mailbox); empty = none
NOX_SMTP_REPLY_TO=
# Staff addresses for "new application" notices, comma separated
NOX_STAFF_NOTIFY=ops@example.kz

# Invoices: seller requisites printed on every invoice (placeholders; fill in the real ones on the server)
NOX_SELLER_NAME=Nox service
NOX_SELLER_BIN=000000000000
NOX_SELLER_ADDRESS=г. Усть-Каменогорск, ул. Примерная, 1
NOX_SELLER_BANK=АО «Банк-пример»
NOX_SELLER_IIK=KZ000000000000000000
NOX_SELLER_BIK=XXXXKZKA
NOX_SELLER_KBE=17
NOX_SELLER_PHONE=+7 700 000 00 00
# days to pay an invoice (printed on it)
NOX_INVOICE_DUE_DAYS=5

# Free test tariff: shown to clients (false = only staff assign it); max Free accounts approved/provisioning/active
# at once; trial length in days (then suspended until a paid tariff is paid). One trial per e-mail / phone.
NOX_FREE_TARIFF_PUBLIC=true
NOX_FREE_MAX_ACTIVE=20
NOX_FREE_DAYS=7

# Client-facing texts. Coins of one typical client dialog: tariff cards and the cabinet show "≈ N диалогов".
NOX_COINS_PER_DIALOG=20
# Support contacts shown in the portal (header/footer, login panel, cabinet) and in the signature of every letter.
# Empty = not shown. WhatsApp: the number in digits, the portal links to https://wa.me/<digits>.
# Left empty here on purpose (portal-install.sh copies this file); fill in on the server, e.g.
#   NOX_SUPPORT_PHONE=+7 700 000 00 00
#   NOX_SUPPORT_WHATSAPP=77000000000
NOX_SUPPORT_PHONE=
NOX_SUPPORT_WHATSAPP=
# Edition date of /offer, /refund, /privacy (e.g. 01.12.2026); empty = the pages carry a "Черновик" banner.
# Requisites in the documents come from NOX_SELLER_* (placeholders above are not printed).
NOX_LEGAL_DATE=

# Online payments: empty / none = off (clients pay invoices issued by a manager).
# mock = fake checkout for test stands; works only with NOX_EMAIL_MODE=log or NOX_PAYMENT_MOCK_ALLOWED=true.
NOX_PAYMENT_PROVIDER=
NOX_PAYMENT_MOCK_ALLOWED=false
NOX_PAYMENT_MOCK_RECURRING=false
# kaspi ("Платежи на Kaspi.kz", check/pay protocol NOT verified yet): QR / deeplink template with {account} and
# {amount} (exact URL comes from Kaspi); callbacks only from these IPs/CIDRs and/or with Basic auth user:password.
NOX_KASPI_PAY_URL_TEMPLATE=
# Static Kaspi Pay QR (the https link from the QR in the Kaspi Pay app): shown on unpaid invoices, payments are
# confirmed by hand ("Оплачено" in the staff panel). Empty = not shown.
NOX_KASPI_STATIC_QR=
NOX_KASPI_ALLOWED_IPS=
NOX_KASPI_BASIC_AUTH=

# A claimed provisioning job without a result after this many minutes is marked failed
NOX_JOB_TIMEOUT_MINUTES=30

# ---- LLM gateway (/llm/anthropic|openai|gemini/...) ----
# Company keys of the providers (sk-ant-api03-…, sk-proj-…, AIza…); typed in on the server only.
# A provider without a key answers 503 to the bots.
NOX_UPSTREAM_ANTHROPIC_KEY=
NOX_UPSTREAM_OPENAI_KEY=
NOX_UPSTREAM_GEMINI_KEY=
# Price overrides, $ per 1M tokens, same format as ILER_MODEL_PRICES of the bot:
#   {"gpt-5.4-mini": [0.25, 2.0], "gemini-3.8-flash": [0.3, 2.5]}   (optional 3rd/4th: cache write/read)
# Built in: claude-sonnet-5-5 [2, 10], claude-haiku-5-5 [0.1, 0.5]; unknown models: the provider's top rate
NOX_MODEL_PRICES=
# Per virtual key: requests per minute; request body cap in bytes (nginx client_max_body_size must match)
NOX_GATEWAY_RATE_PER_MINUTE=60
NOX_GATEWAY_MAX_BODY_BYTES=10485760

# Billing periods: days of grace after an unpaid renewal before suspension; days before the period end when staff
# are asked to issue the renewal invoice (and the client gets a reminder)
NOX_GRACE_DAYS=3
NOX_RENEWAL_INVOICE_DAYS=5
NOX_TZ=Asia/Almaty

# Provider failure alerts and the daily summary go to NOX_STAFF_NOTIFY and, if set, to Telegram
NOX_ALERT_TELEGRAM_BOT_TOKEN=
NOX_ALERT_TELEGRAM_CHAT_ID=
NOX_ALERT_ERROR_THRESHOLD=5
NOX_ALERT_WINDOW_SECONDS=300

# Ports on 127.0.0.1: web (Cloudflare Tunnel route for bot.noxsw.kz) and the provisioner's internal API
NOX_HTTP_PORT=8100
NOX_INTERNAL_PORT=8099
