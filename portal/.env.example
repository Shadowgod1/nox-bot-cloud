# Nox portal settings (/opt/nox-portal/.env, mode 600). portal-install.sh creates this file from here,
# replaces __GENERATE__ with fresh secrets and sets NOX_PROVISIONER_TOKEN_SHA256. Placeholders only.

# Public address of the portal (https => Secure cookies) and the domain of client bots (<slug>.<domain>)
NOX_PUBLIC_URL=https://bot.noxsw.kz
NOX_INSTANCE_DOMAIN=noxsw.kz
# Extra reserved bot addresses, comma separated (the built-in list is in nox_portal/slugs.py)
NOX_RESERVED_SLUGS=

# Secrets (generated by portal-install.sh, never commit real values)
NOX_SECRET_KEY=__GENERATE__
NOX_DB_PASSWORD=__GENERATE__
# sha256 of the provisioner token in /etc/nox-portal/provisioner.env (set by portal-install.sh)
NOX_PROVISIONER_TOKEN_SHA256=

# E-mail: smtp | log (development only: letters with codes and links go to the log)
NOX_EMAIL_MODE=smtp
NOX_SMTP_HOST=smtp.example.kz
NOX_SMTP_PORT=587
# starttls (587) | ssl (465) | none
NOX_SMTP_SECURITY=starttls
NOX_SMTP_USER=bot@example.kz
NOX_SMTP_PASSWORD=
NOX_SMTP_FROM=bot@example.kz
# Staff addresses for "new application" notices, comma separated
NOX_STAFF_NOTIFY=ops@example.kz

# Invoices: seller requisites printed on every invoice (placeholders; fill in the real ones on the server)
NOX_SELLER_NAME=Nox service
NOX_SELLER_BIN=000000000000
NOX_SELLER_ADDRESS=г. Усть-Каменогорск, ул. Примерная, 1
NOX_SELLER_BANK=АО «Банк-пример»
NOX_SELLER_IIK=KZ000000000000000000
NOX_SELLER_BIK=XXXXKZKA
NOX_SELLER_KBE=17
NOX_SELLER_PHONE=+7 700 000 00 00
# days to pay an invoice (printed on it)
NOX_INVOICE_DUE_DAYS=5

# A claimed provisioning job without a result after this many minutes is marked failed
NOX_JOB_TIMEOUT_MINUTES=30

# Ports on 127.0.0.1: web (Cloudflare Tunnel route for bot.noxsw.kz) and the provisioner's internal API
NOX_HTTP_PORT=8100
NOX_INTERNAL_PORT=8099
