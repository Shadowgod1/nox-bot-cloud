# ILER Bot configuration. deploy/install.sh copies this to <dir>/.env (mode 600)
# and replaces every __GENERATE__ with a fresh random secret. Existing values are never overwritten.

# Release (set by install.sh from deploy/channel/stable.env; changed by the updater)
ILER_VERSION=0.1.0
ILER_IMAGE_OWNER=shadowgod1

# Admin UI port on the LAN (the only published port)
ILER_HTTP_PORT=8080
# Install directory (backups live in $ILER_DIR/backups)
ILER_DIR=/opt/iler
ILER_TZ=Asia/Almaty

# Where the updater looks for the newest stable version (falls back to deploy/channel/stable.env)
ILER_CHANNEL_URL=https://github.com/shadowgod1/iler-bot/releases/latest/download/stable.env

# Secrets (generated by install.sh)
# 32 random bytes, base64: AES-GCM key for stored secrets + session key derivation
ILER_SECRET_KEY=__GENERATE__
ILER_DB_PASSWORD=__GENERATE__
ILER_EVO_DB_PASSWORD=__GENERATE__
ILER_EVO_API_KEY=__GENERATE__
ILER_UPDATER_TOKEN=__GENERATE__
ILER_REDIS_PASSWORD=__GENERATE__
# One-time token for the first-run wizard: install.sh prints http://<lan-ip>:<port>/setup?token=<it>.
# Only whoever has this link can create the owner account.
ILER_SETUP_TOKEN=__GENERATE__

# ILER's LLM API keys. Set by the ILER technician: sudo bash <dir>/deploy/set-llm-keys.sh
# (never by the client; the admin UI only chooses provider and model among providers with a key)
ILER_ANTHROPIC_KEY=
ILER_OPENAI_KEY=
ILER_GEMINI_KEY=

# Optional image digests from the release channel (empty = pull by tag; set by install.sh / updater)
ILER_CORE_DIGEST=
ILER_WEB_DIGEST=
ILER_UPDATER_DIGEST=
