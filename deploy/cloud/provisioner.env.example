# Nox provisioner settings: /etc/nox-portal/provisioner.env (root:root, mode 600).
# portal-install.sh creates it from here and generates NOX_PROVISIONER_TOKEN. Placeholders only:
# real keys and tokens are typed in on the server, never put into chats, tickets or git.

# Portal internal API (loopback only) and the shared token (the portal keeps only its sha256)
NOX_PORTAL_INTERNAL_URL=http://127.0.0.1:8099
NOX_PROVISIONER_TOKEN=__GENERATE__
# Private half of the key pair that seals per-client Anthropic keys (generated by portal-install.sh)
NOX_PROVISIONER_KEY_FILE=/etc/nox-portal/provisioner-key.pem

# LLM gateway of the portal: new instances get ILER_LLM_GATEWAY_URL=<this> and their own virtual key
# (ILER_LLM_GATEWAY_KEY) instead of real provider keys. The real keys live only in the portal .env.
NOX_GATEWAY_URL=https://bot.noxsw.kz
# "Пополнить" button of the bot admin (ILER_TOPUP_URL of new instances): the client cabinet
NOX_TOPUP_URL=https://bot.noxsw.kz/cabinet

# Legacy: Anthropic key (sk-ant-api03-…) only for jobs queued before the gateway existed; leave empty
NOX_DEFAULT_ANTHROPIC_KEY=

# Unpacked iler-bot release bundle (the folder with compose.yml, deploy/ and images.tar)
NOX_ILER_CLIENT=/opt/iler/bundle/deploy/cloud/iler-client.sh
NOX_CLIENTS_DIR=/opt/iler/clients
NOX_DOMAIN=noxsw.kz
# Admin ports of new clients on 127.0.0.1; 8099/8100 belong to the portal
NOX_PORT_MIN=8110
NOX_PORT_MAX=8999
NOX_RESERVED_PORTS=8099,8100
NOX_MAX_JOBS_PER_RUN=5

# Cloudflare: API token with Account / Cloudflare Tunnel / Edit and Zone / DNS / Edit (zone noxsw.kz)
CF_API_TOKEN=
CF_ACCOUNT_ID=
# tunnel UUID of iler-cloud-01 (Zero Trust -> Networks -> Tunnels)
CF_TUNNEL_ID=
CF_ZONE_ID=
